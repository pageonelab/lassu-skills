{
  "schemaVersion": 1,
  "pluginVersion": "0.2.0",
  "automationProtocol": {
    "min": 1,
    "max": 1
  },
  "workflowVersion": 1,
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "runtimeReadinessChecks": {
    "lassu-record-video": "canRecord",
    "lassu-edit-screenshot": "canScreenshot"
  },
  "optionalCapabilities": {
    "narratedProduction": "demo_production",
    "multipleSourceProduction": "demo_sources_v2",
    "drawArtifactImport": "demo_draw_import_v1",
    "measuredNarrationTiming": "demo_narration_timing_v1"
  },
  "runtimeBundled": false,
  "remoteServices": {
    "lassu-draw": {
      "transport": "streamable-http",
      "endpoint": "https://api.lassu.ai/mcp/draw",
      "authentication": "oauth",
      "readinessTool": "lassu_draw_get_context",
      "capability": "draw_authoring_v1",
      "requiresDesktop": false
    }
  }
}
